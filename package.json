{
  "name": "career-compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "setup:local": "node scripts/setup-local.mjs",
    "lint": "eslint app tests proxy.ts eslint.config.mjs next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "worker": "tsc -p tsconfig.worker.json && node --env-file=.env.local scripts/sync-worker.mjs",
    "start:cloud": "node scripts/start-cloud.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.4.5",
    "typescript": "^5.8.3"
  }
}
