# Local-only runtime. Node 24+; npm run setup:local creates .env.local safely.
APP_URL=http://127.0.0.1:3000
CAREER_DB_PATH=.data/career-compass.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ACCOUNT_EMAIL=
# 64 hex characters, generated locally. Never share or commit.
TOKEN_ENCRYPTION_KEY=

# Cloud deployment only: HTTPS origin, persistent disk, and owner login required.
# DEPLOYMENT_MODE=cloud
# APP_URL=https://your-domain.up.railway.app
# CAREER_DB_PATH=/data/career-compass.sqlite
# OWNER_PASSWORD_HASH=<salt:hash generated by prepare-cloud-env.mjs>
# OWNER_SESSION_SECRET=<64 hex characters>
